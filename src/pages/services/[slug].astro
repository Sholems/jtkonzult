---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const canonical = `/services/${service.slug}/`;
const seoTitles = {
  'recruitment-staffing': 'Recruitment Agency in Nigeria | J.T. Resources',
  'labour-outsourcing': 'Labour Outsourcing Nigeria | J.T. Resources',
  'hr-consulting': 'HR Consulting Nigeria | J.T. Resources',
  'training-capacity-development': 'Corporate Training Nigeria | J.T. Resources',
  'ppe-supply': 'PPE Supply Nigeria | J.T. Resources',
  'cleaning-janitorial-services': 'Commercial Cleaning Nigeria | J.T. Resources',
  'facility-support': 'Facility Support Nigeria | J.T. Resources'
};
const faqItems = [
  { question: `How does a ${service.title.toLowerCase()} engagement begin?`, answer: `We start with a short requirement review covering your objectives, location, timing, workforce or service scope, and any operational constraints. We then recommend a practical next step.` },
  { question: `Can ${service.title.toLowerCase()} be tailored to our organisation?`, answer: `Yes. The scope, delivery approach, reporting and support arrangements are adapted to your industry, operating environment and specific requirements.` },
  { question: `Where is this service available?`, answer: `J.T. Resources supports organisations across Nigeria, including Lagos, Abuja, Ogun, Delta and Akwa-Ibom, with additional locations assessed according to project requirements.` }
];
const pageUrl = new URL(canonical, Astro.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.summary,
  url: pageUrl,
  provider: { '@type': 'Organization', name: 'J.T. Resources & Konzult Ltd', url: new URL('/', Astro.site).toString() },
  areaServed: { '@type': 'Country', name: 'Nigeria' }
};
const breadcrumbData = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
  { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', Astro.site).toString() },
  { '@type': 'ListItem', position: 3, name: service.title, item: pageUrl }
] };
const faqData = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) };
---

<Layout title={seoTitles[service.slug]} description={service.summary} structuredData={[structuredData, breadcrumbData, faqData]}>
  <main>
    <section class="service-detail-hero">
      <div class="container service-detail-hero__inner">
        <nav class="breadcrumbs breadcrumbs-light" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/services/">Services</a><span>/</span><span aria-current="page">{service.title}</span></nav>
        <div class="service-detail-icon"><i class={`fa-solid ${service.icon}`} aria-hidden="true"></i></div>
        <p class="eyebrow">Workforce and business support across Nigeria</p>
        <h1>{service.title}</h1>
        <p>{service.summary}</p>
        <a class="btn btn-primary" href={`/contact/?service=${encodeURIComponent(service.title)}`}>Request This Service</a>
      </div>
    </section>

    <section class="section">
      <div class="container service-detail-grid">
        <article>
          <h2>How we support your organisation</h2>
          <p class="lead">{service.description}</p>
          <h3>What the engagement can include</h3>
          <ul class="check-list">{service.benefits.map((benefit) => <li>{benefit}</li>)}</ul>
        </article>
        <aside class="soft-card service-enquiry-card">
          <h2>Discuss your requirement</h2>
          <p>Tell us the roles, headcount, location, schedule or operational challenge. Our team will recommend an appropriate next step.</p>
          <a class="btn btn-primary" href={`/contact/?service=${encodeURIComponent(service.title)}`}>Contact Our Team</a>
          <a class="text-link" href="tel:+2349157235560">Call 0915 723 5560</a>
        </aside>
      </div>
    </section>

    <section class="section section-alt">
      <div class="container">
        <div class="section-heading"><p class="eyebrow">A clear delivery process</p><h2>What to expect</h2></div>
        <ol class="process-grid">{service.steps.map((step, index) => <li><span>{index + 1}</span><p>{step}</p></li>)}</ol>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2>Industries and environments we support</h2>
        <div class="industry-list">{service.industries.map((industry) => <span>{industry}</span>)}</div>
        <div class="service-bottom-cta"><h2>Need dependable {service.title.toLowerCase()}?</h2><p>Share your requirement and location with our consultants.</p><a class="btn btn-primary" href={`/contact/?service=${encodeURIComponent(service.title)}`}>Request Support</a></div>
      </div>
    </section>

    <section class="section section-alt">
      <div class="container service-faq-layout">
        <div><p class="eyebrow">Helpful answers</p><h2>Frequently asked questions</h2><p>Have a different requirement? Our team normally acknowledges enquiries within one business day.</p><a class="text-link" href={`/contact/?service=${encodeURIComponent(service.title)}`}>Ask our consultants →</a></div>
        <div class="faq-list">{faqItems.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
      </div>
    </section>
  </main>
</Layout>
