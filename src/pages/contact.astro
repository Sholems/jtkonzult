---
import Layout from '../layouts/Layout.astro';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? '1x00000000000000000000AA' : '');
---

<Layout title="Contact Us — J.T. Resources & Konzult Ltd" description="Get in touch for recruitment, outsourcing, consulting, training, facility services, or PPE supply.">
  <section style={{ position: 'relative', background: '#0f172a', color: '#fff', minHeight: '260px', display: 'grid', placeItems: 'center', overflow: 'hidden' }}>
    <img src="/images/site/hero-main.webp" width="1920" height="1080" alt="Contact J.T. Resources" style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', objectFit: 'cover', opacity: 0.6 }} />
    <div style={{ position: 'relative', zIndex: 1, width: 'min(860px, calc(100% - 2rem))', textAlign: 'center' }}>
      <h1 style={{ color: '#fff', fontSize: 'clamp(2.3rem, 5vw, 3.5rem)' }}>Contact Us</h1>
      <p style={{ color: 'rgba(255,255,255,0.9)', maxWidth: '720px', margin: '0 auto' }}>We’re ready to support your HR and outsourcing needs. Use the form to reach out and our team will respond promptly.</p>
    </div>
  </section>

  <main class="container section">
    <div class="grid-2" style={{ alignItems: 'start' }}>
      <div class="soft-card contact-card">
        <h2>Get in Touch</h2>
        <p>Contact us for recruitment, outsourcing, consulting, training, facility services, or PPE supply.</p>
        <ul style={{ listStyle: 'none', padding: 0, margin: '1.5rem 0 0', display: 'grid', gap: '0.8rem', color: '#334155' }}>
          <li><i class="fa-solid fa-building" style={{ color: 'var(--green-text)', marginRight: '0.7rem' }}></i>J.T. Resources & Konzult Ltd</li>
          <li><i class="fa-solid fa-envelope" style={{ color: 'var(--green-text)', marginRight: '0.7rem' }}></i><a href="mailto:info@jtkonzult.com.ng" style={{ color: '#326664' }}>info@jtkonzult.com.ng</a></li>
          <li><i class="fa-solid fa-phone" style={{ color: 'var(--green-text)', marginRight: '0.7rem' }}></i><a href="tel:+2349157235560">0915 723 5560</a>, <a href="tel:+2348166738614">0816 673 8614</a></li>
          <li><i class="fa-solid fa-phone" style={{ color: 'var(--green-text)', marginRight: '0.7rem' }}></i><a href="tel:+2347056288547">0705 628 8547</a>, <a href="tel:+2348030585300">0803 058 5300</a></li>
          <li><i class="fa-solid fa-location-dot" style={{ color: 'var(--green-text)', marginRight: '0.7rem' }}></i>Head Office: C/O Wazobia Affrikana Hotel, Emu-Ebendo, Delta State</li>
          <li><i class="fa-solid fa-location-dot" style={{ color: 'var(--green-text)', marginRight: '0.7rem' }}></i>Lagos: 1 Charlemenz Avenue, Aradagun, Badagry</li>
          <li><i class="fa-solid fa-location-dot" style={{ color: 'var(--green-text)', marginRight: '0.7rem' }}></i>Ogun: C/O Sonhart Investments Ltd, Sango Ota</li>
        </ul>
        <div class="contact-expectation"><i class="fa-regular fa-clock" aria-hidden="true"></i><div><strong>Response time</strong><span>We normally acknowledge enquiries within one business day, Monday to Friday.</span></div></div>
        <a class="google-profile-link" href="https://share.google/zfuWYIpMhYKxTiPe9" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-google" aria-hidden="true"></i> View our Google Business Profile</a>
      </div>

      <div class="soft-card contact-card">
        <form id="contact-form" action="/api/contact" method="post">
          <div style={{ display: 'grid', gap: '1rem' }}>
            <label style={{ display: 'grid', gap: '0.35rem', fontWeight: 600 }}>Full Name
              <input type="text" name="name" placeholder="Your full name" required style={{ padding: '0.8rem 0.9rem', border: '1px solid #dfe7ee', borderRadius: '0.5rem' }} />
            </label>
            <label style={{ display: 'grid', gap: '0.35rem', fontWeight: 600 }}>Email
              <input type="email" name="email" placeholder="you@example.com" required style={{ padding: '0.8rem 0.9rem', border: '1px solid #dfe7ee', borderRadius: '0.5rem' }} />
            </label>
            <label style={{ display: 'grid', gap: '0.35rem', fontWeight: 600 }}>Phone Number
              <input type="tel" name="phone" placeholder="+234..." style={{ padding: '0.8rem 0.9rem', border: '1px solid #dfe7ee', borderRadius: '0.5rem' }} />
            </label>
            <label style={{ display: 'grid', gap: '0.35rem', fontWeight: 600 }}>Organization / Company
              <input type="text" name="company" placeholder="Company name" style={{ padding: '0.8rem 0.9rem', border: '1px solid #dfe7ee', borderRadius: '0.5rem' }} />
            </label>
            <label class="form-trap" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            <label style={{ display: 'grid', gap: '0.35rem', fontWeight: 600 }}>Service Type
              <select name="service" style={{ padding: '0.8rem 0.9rem', border: '1px solid #dfe7ee', borderRadius: '0.5rem' }}>
                <option>Recruitment & Staffing</option>
                <option>Labour Outsourcing</option>
                <option>HR Consulting</option>
                <option>Training & Capacity Development</option>
                <option>Personal Protective Equipment Supply</option>
                <option>Cleaning & Janitorial Services</option>
                <option>Facility Support Services</option>
                <option>Other</option>
              </select>
            </label>
            <label style={{ display: 'grid', gap: '0.35rem', fontWeight: 600 }}>Message / Project Details
              <textarea name="message" rows="5" required placeholder="Tell us about your needs" style={{ padding: '0.8rem 0.9rem', border: '1px solid #dfe7ee', borderRadius: '0.5rem' }}></textarea>
            </label>
            {turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact" data-theme="light"></div> : <p class="form-config-notice">Secure form verification must be configured before production submissions are enabled.</p>}
            <button type="submit" class="btn btn-primary" disabled={!turnstileSiteKey}>Submit Inquiry</button>
            <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
          </div>
        </form>
      </div>
    </div>
  </main>

  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const status = document.querySelector<HTMLElement>('#form-status');
    const select = form?.querySelector<HTMLSelectElement>('[name="service"]');
    const requestedService = new URLSearchParams(window.location.search).get('service');
    if (requestedService && select && [...select.options].some((option) => option.value === requestedService)) select.value = requestedService;

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      status.className = 'form-status';
      status.textContent = 'Sending your enquiry…';
      if (button) button.disabled = true;
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Unable to send your enquiry.');
        form.reset();
        status.classList.add('is-success');
        status.textContent = 'Thank you. Your enquiry has been sent and our team will respond shortly.';
      } catch (error) {
        status.classList.add('is-error');
        status.innerHTML = `${error instanceof Error ? error.message : 'Unable to send your enquiry.'} Please email <a href="mailto:info@jtkonzult.com.ng">info@jtkonzult.com.ng</a>.`;
      } finally {
        (window as any).turnstile?.reset();
        if (button) button.disabled = false;
      }
    });
  </script>
</Layout>
