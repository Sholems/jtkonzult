---
import Layout from '../layouts/Layout.astro';
import { localPosts } from '../data/localPosts';

const featuredPosts = localPosts.slice(0, 3);
---

<Layout title="HR Consultancy & Labour Outsourcing in Nigeria | J.T. Resources" description="Licensed Nigerian HR consultancy providing recruitment, labour outsourcing, HR consulting, training, PPE supply and facility support nationwide." wave>
  <main>
    <section class="hero-surface">
      <img src="/images/site/hero-main.webp" width="1920" height="1080" fetchpriority="high" alt="J.T. Resources hero background" />
      <div class="hero-content">
        <div class="hero-copy">
          <div class="eyebrow">Federal Government Licensed HR Consultants</div>
          <h1>Building Reliable, Skilled and Productive Teams Across Nigeria</h1>
          <p>We deliver recruitment, labour outsourcing, HR consulting, training, PPE supply and facility support with integrity and a nationwide reach. Trusted since 1993.</p>
          <div style={{ display: 'flex', flexWrap: 'wrap', gap: '0.85rem', marginTop: '2rem' }}>
            <a class="btn btn-primary" href="/contact">Request HR Support</a>
            <a class="btn btn-secondary" href="/services" style={{ color: '#fff', borderColor: '#fff' }}>View Our Services</a>
          </div>
          <div style={{ display: 'flex', flexWrap: 'wrap', gap: '0.75rem', marginTop: '2rem' }}>
            <div style={{ padding: '0.9rem 1rem', background: 'rgba(255,255,255,0.1)', border: '1px solid rgba(255,255,255,0.2)', minWidth: '150px' }}>
              <div style={{ fontWeight: 700 }}>Since 1993</div>
              <div style={{ fontSize: '0.7rem', opacity: 0.8 }}>Established experience</div>
            </div>
            <div style={{ padding: '0.9rem 1rem', background: 'rgba(255,255,255,0.1)', border: '1px solid rgba(255,255,255,0.2)', minWidth: '180px' }}>
              <div style={{ fontWeight: 700 }}>Nationwide</div>
              <div style={{ fontSize: '0.7rem', opacity: 0.8 }}>Lagos • Abuja • Ogun • Delta • Akwa-Ibom</div>
            </div>
            <div style={{ padding: '0.9rem 1rem', background: 'rgba(255,255,255,0.1)', border: '1px solid rgba(255,255,255,0.2)', minWidth: '145px' }}>
              <div style={{ fontWeight: 700 }}>Licensed</div>
              <div style={{ fontSize: '0.7rem', opacity: 0.8 }}>Federal government accredited</div>
            </div>
          </div>
        </div>

        <div class="hero-card" style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>
          <img src="/images/site/hero-support.webp" width="1920" height="1080" alt="Operations and support" style={{ width: '100%', height: '280px', objectFit: 'cover', borderRadius: '0.8rem' }} />
          <div style={{ display: 'flex', alignItems: 'center', gap: '0.9rem' }}>
            <div style={{ width: '64px', height: '64px', display: 'grid', placeItems: 'center', background: 'var(--primary-green)', color: 'var(--on-green)', fontWeight: 700 }}>JT</div>
            <div>
              <div style={{ fontWeight: 700, color: '#0f172a' }}>Trusted HR Partner</div>
              <div style={{ fontSize: '0.8rem', color: '#6b7280' }}>Delivering workforce solutions, compliance and reliable staff across Nigeria.</div>
            </div>
          </div>
          <div style={{ textAlign: 'right' }}>
            <a class="btn btn-primary" href="/contact">Get Support</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container grid-2" style={{ alignItems: 'center' }}>
        <div>
          <img src="/images/site/about-team.webp" width="740" height="416" loading="lazy" alt="Two Nigerian professionals discussing a business project" style={{ width: '100%', height: '420px', objectFit: 'cover', borderRadius: '1rem', boxShadow: '0 12px 30px rgba(15, 23, 42, 0.12)' }} />
        </div>
        <div>
          <h2>About J.T. Resources</h2>
          <p style={{ fontSize: '1.06rem', color: '#475569' }}>Founded in 1993 and incorporated in 2011, J.T. Resources & Konzult Ltd is a federally licensed HR management consultancy offering recruitment, outsourcing, HR consulting, training, PPE supply and facility support across Nigeria. We deliver tailored workforce solutions emphasising integrity and measurable results.</p>
          <ul style={{ listStyle: 'none', padding: 0, margin: '1.5rem 0 0', display: 'grid', gap: '0.9rem', color: '#334155' }}>
            <li><i class="fa-solid fa-check" style={{ color: 'var(--green-text)', marginRight: '0.75rem' }}></i><strong>Founded:</strong> 1993</li>
            <li><i class="fa-solid fa-check" style={{ color: 'var(--green-text)', marginRight: '0.75rem' }}></i><strong>Incorporated:</strong> 2011</li>
            <li><i class="fa-solid fa-check" style={{ color: 'var(--green-text)', marginRight: '0.75rem' }}></i><strong>Services:</strong> Recruitment, Outsourcing, Consulting, Training, Facility Support</li>
            <li><i class="fa-solid fa-check" style={{ color: 'var(--green-text)', marginRight: '0.75rem' }}></i><strong>Coverage:</strong> Major commercial centres across Nigeria</li>
          </ul>
          <div style={{ display: 'flex', flexWrap: 'wrap', gap: '0.8rem', marginTop: '2rem' }}>
            <a class="btn btn-primary" href="/about">Learn More</a>
            <a class="btn btn-secondary" href="/contact">Contact Us</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt" style={{ background: 'linear-gradient(180deg, #326664 0%, rgba(50,102,100,0.94) 100%)', color: '#fff' }}>
      <div class="container">
        <div style={{ textAlign: 'center', marginBottom: '2rem' }}>
          <h2 style={{ color: '#fff' }}>Our Core Services</h2>
          <p style={{ maxWidth: '720px', margin: '0 auto', color: 'rgba(255,255,255,0.9)' }}>Comprehensive HR and operational support to keep your organisation productive, compliant and safe.</p>
        </div>
        <div class="grid-3">
          {[ 
            { icon: 'fa-user-tie', title: 'Recruitment & Staffing', desc: 'Permanent, temporary and contract staffing across industries focused on the right fit and reliability.', link: '/services/recruitment-staffing' },
            { icon: 'fa-people-roof', title: 'Labour Outsourcing', desc: 'Supply and management of skilled to unskilled labour for factories, hotels, sites and offices — supervised and compliant.', link: '/services/labour-outsourcing' },
            { icon: 'fa-clipboard-check', title: 'Compliance & Training', desc: 'Industry-specific training, HR compliance audits and safety briefings to keep your workforce certified and productive.', link: '/services/training-capacity-development' }
          ].map((item) => (
            <article class="soft-card card-hover" style={{ padding: '1.5rem', color: '#0f172a' }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: '1rem' }}>
                <div style={{ width: '56px', height: '56px', display: 'grid', placeItems: 'center', background: 'var(--primary-green)', color: 'var(--on-green)', borderRadius: '0.75rem', fontSize: '1.4rem' }}><i class={`fa-solid ${item.icon}`}></i></div>
                <div>
                  <h3 style={{ marginBottom: '0.4rem' }}>{item.title}</h3>
                  <p style={{ color: '#475569', marginBottom: 0 }}>{item.desc}</p>
                </div>
              </div>
              <a href={item.link} style={{ display: 'inline-block', marginTop: '1rem', fontWeight: 700, color: 'var(--green-text)' }}>Learn More →</a>
            </article>
          ))}
        </div>
        <div style={{ textAlign: 'center', marginTop: '2.5rem' }}>
          <a class="btn btn-primary" href="/services" style={{ background: '#fff', color: '#326664' }}>Explore All Services</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2>Trusted By Organisations Across Nigeria</h2>
        <p style={{ color: '#475569' }}>We serve manufacturing, hospitality, construction, offices and more.</p>
        <div class="client-logo-grid">
          {[
            { file: 'the-land-of.jpg', name: 'The Land Of' },
            { file: 'Sonhart.jpg', name: 'Sonhart' },
            { file: 'sona-group.jpg', name: 'Sona Group' },
            { file: 'GREENFUELS.jpg', name: 'Greenfuels' },
            { file: 'Globus.jpg', name: 'Globus' },
            { file: 'ENERGIA.jpg', name: 'Energia' },
            { file: 'ELSEWEDY.jpg', name: 'Elsewedy' },
            { file: 'COVENANT.jpg', name: 'Covenant' },
            { file: 'DARAJU.jpg', name: 'Daraju' },
            { file: 'ARISTO.jpg', name: 'Aristo' }
          ].map((client) => (
            <div class="client-logo-item">
              <img loading="lazy" width="150" height="80" src={`/images/clients/${client.file.replace('.jpg', '.webp')}`} alt={`${client.name} client logo`} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt">
      <div class="container">
        <div style={{ textAlign: 'center', marginBottom: '2rem' }}>
            <h2>What Our Clients Say</h2>
            <p style={{ maxWidth: '700px', margin: '0 auto', color: '#475569' }}>Feedback from organisations that use our recruitment, outsourcing and training services. Identifying details are withheld for client privacy.</p>
        </div>
        <div class="testimonial-grid">
          {[
              { initials: 'HR', quote: 'The recruitment process was professional and well coordinated. The team understood our staffing needs and supplied candidates who were ready for the role.', name: 'HR Client', role: 'Manufacturing sector' },
              { initials: 'OP', quote: 'Their labour support is dependable, and communication remains clear from mobilisation through ongoing workforce management.', name: 'Operations Client', role: 'Multi-site operations' },
              { initials: 'FM', quote: 'The training was practical, relevant to our workplace and easy for our employees to apply in their daily responsibilities.', name: 'Facilities Client', role: 'Hospitality sector' }
          ].map((item) => (
            <figure class="testimonial-card">
              <div class="testimonial-layout">
                <div class="testimonial-avatar">{item.initials}</div>
                <figcaption>
                  <blockquote>“{item.quote}”</blockquote>
                  <div class="testimonial-person"><strong>{item.name}</strong><span>{item.role}</span></div>
                  <div class="testimonial-stars" aria-label="5 out of 5 stars">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                  </div>
                </figcaption>
              </div>
            </figure>
          ))}
        </div>
        <div class="google-review-prompt">
          <div class="google-review-icon"><i class="fa-brands fa-google" aria-hidden="true"></i></div>
          <div>
            <div class="google-review-stars" aria-label="Five stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
            <h3>Worked with our team?</h3>
            <p>Your feedback helps other organisations choose a trusted HR partner and helps us continue improving our service.</p>
          </div>
          <a class="btn btn-primary" href="https://share.google/zfuWYIpMhYKxTiPe9" target="_blank" rel="noopener noreferrer">Leave a Google Review <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>

    <section class="section home-insights-section">
      <div class="container">
        <div class="home-insights-heading">
          <div>
            <span class="section-kicker">Knowledge for better workplaces</span>
            <h2>Latest HR Insights</h2>
            <p>Practical guidance to help Nigerian organisations build stronger teams, improve workforce systems and make informed people decisions.</p>
          </div>
          <a class="btn btn-secondary" href="/blog">View All Insights</a>
        </div>
        <div class="home-insights-grid">
          {featuredPosts.map((post) => {
            const title = post.title.rendered;
            const category = post._embedded['wp:term'][0][0].name;
            const image = post._embedded['wp:featuredmedia'][0].source_url;
            const date = new Date(post.date).toLocaleDateString('en-NG', { day: 'numeric', month: 'short', year: 'numeric' });
            return (
              <article class="home-insight-card">
                <a class="home-insight-image" href={`/blog/${post.slug}`} aria-label={`Read ${title}`}>
                  <img src={image} alt={title} width="1672" height="941" loading="lazy" />
                </a>
                <div class="home-insight-copy">
                  <div class="home-insight-meta"><span>{category}</span><time datetime={post.date}>{date}</time></div>
                  <h3><a href={`/blog/${post.slug}`}>{title}</a></h3>
                  <p>{post.seoDescription}</p>
                  <a class="home-insight-link" href={`/blog/${post.slug}`}>Read article <span aria-hidden="true">→</span></a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section" style={{ background: 'rgba(148, 194, 26, 0.04)' }}>
      <div class="container">
        <h2 style={{ textAlign: 'center' }}>Our Group</h2>
        <p style={{ textAlign: 'center', color: '#475569', marginBottom: '2rem' }}>Integrated companies working together to provide HR, facility management and hospitality services.</p>

        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(250px, 1fr))', gap: '1.5rem', maxWidth: '760px', margin: '0 auto' }}>
          <article class="soft-card card-hover" style={{ padding: '1.5rem' }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: '0.8rem', marginBottom: '1rem' }}>
              <div style={{ width: '52px', height: '52px', display: 'grid', placeItems: 'center', background: 'var(--primary-green)', color: 'var(--on-green)', borderRadius: '0.75rem' }}><i class="fa-solid fa-broom"></i></div>
              <h3>Ozone Cleaning & Maintenance</h3>
            </div>
            <p style={{ color: '#475569' }}>Professional cleaning, janitorial and maintenance services for offices, factories and residential clients.</p>
            <a href="/services/cleaning-janitorial-services" style={{ color: 'var(--deep-teal)', fontWeight: 700 }}>Learn More →</a>
          </article>

          <article class="soft-card card-hover" style={{ padding: '1.5rem' }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: '0.8rem', marginBottom: '1rem' }}>
              <div style={{ width: '52px', height: '52px', display: 'grid', placeItems: 'center', background: 'var(--primary-green)', color: 'var(--on-green)', borderRadius: '0.75rem' }}><i class="fa-solid fa-hotel"></i></div>
              <h3>Wazobia Affrikana Hotel</h3>
            </div>
            <p style={{ color: '#475569' }}>Hospitality and lodging services that support operations and staff.</p>
            <a href="/contact" style={{ color: 'var(--deep-teal)', fontWeight: 700 }}>Learn More →</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section" style={{ background: 'var(--deep-teal)', color: '#fff', paddingTop: '3rem', paddingBottom: '3rem' }}>
      <div class="container" style={{ textAlign: 'center' }}>
        <h2 style={{ color: '#fff' }}>Need Trusted HR & Outsourcing Support?</h2>
        <p style={{ maxWidth: '720px', margin: '0 auto', color: 'rgba(255,255,255,0.9)' }}>Our team responds quickly with tailored solutions for recruitment, outsourcing and facility support.</p>
        <a class="btn btn-primary" href="/contact" style={{ marginTop: '1.5rem', background: 'var(--primary-green)', color: '#0f172a' }}>Contact Our Team</a>
      </div>
    </section>
  </main>
</Layout>
