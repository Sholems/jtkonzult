---
import Layout from '../../layouts/Layout.astro';
import { localPosts } from '../../data/localPosts';
import { getAllPosts, summarisePost } from '../../data/posts';

export async function getStaticPaths() {
  return (await getAllPosts()).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { title, seoTitle, description: excerpt, image, category, displayDate: date, readingTime } = summarisePost(post);
const imageUrl = new URL(image.url, Astro.site).toString();
const pageUrl = new URL(`/blog/${post.slug}/`, Astro.site).toString();
const relatedPosts = localPosts.filter((item) => item.slug !== post.slug).slice(0, 3).map(summarisePost);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  image: [imageUrl],
  datePublished: post.date,
  dateModified: post.modified || post.date,
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Organization', name: 'J.T. Resources & Konzult Ltd' },
  publisher: { '@type': 'Organization', name: 'J.T. Resources & Konzult Ltd', logo: { '@type': 'ImageObject', url: 'https://jtkonzult.com.ng/images/site/logo.png' } }
};
const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: new URL('/blog/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl }
  ]
};
const faqData = post.faqs?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faqs.map((faq: { question: string; answer: string }) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } }))
} : null;
const pageStructuredData = [structuredData, breadcrumbData, ...(faqData ? [faqData] : [])];
---

<Layout title={seoTitle} description={excerpt} ogImage={imageUrl} ogImageAlt={title} ogImageWidth={image.width} ogImageHeight={image.height} ogImageType={image.type} ogType="article" publishedTime={post.date} modifiedTime={post.modified || post.date} structuredData={pageStructuredData}>
  <section style={{ background: 'var(--deep-teal)', color: '#fff', padding: '4rem 0' }}>
    <div class="container" style={{ textAlign: 'center', maxWidth: '960px' }}>
      <nav class="breadcrumbs breadcrumbs-light" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog/">Insights</a><span>/</span><span aria-current="page">Article</span></nav>
      <div style={{ color: 'rgba(255,255,255,0.8)', fontSize: '0.8rem' }}>{category ? `${category} • ` : ''}{date} • {readingTime}</div>
      <h1 style={{ color: '#fff', marginTop: '0.7rem', fontSize: 'clamp(2.2rem, 5vw, 3.2rem)' }}>{title}</h1>
    </div>
  </section>

  <main class="container section">
    <img src={image.url} alt={title} width={image.width} height={image.height} style={{ width: '100%', maxHeight: '420px', objectFit: 'cover', borderRadius: '1rem', marginBottom: '2rem' }} />

    <div class="article-byline"><span><i class="fa-solid fa-building" aria-hidden="true"></i> J.T. Resources & Konzult Ltd</span><span>Reviewed {date}</span></div>

    <article class="blog-article" set:html={post.content.rendered}></article>

    <div class="article-share" aria-label="Share this article"><strong>Share this guide</strong><a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook"><i class="fa-brands fa-facebook-f"></i></a><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a><a href={`https://wa.me/?text=${encodeURIComponent(`${title} ${pageUrl}`)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp"><i class="fa-brands fa-whatsapp"></i></a></div>

    {relatedPosts.length > 0 && <section class="related-posts" aria-labelledby="related-heading"><h2 id="related-heading">Related HR insights</h2><div>{relatedPosts.map((item) => <article><img src={item.image.url} width={item.image.width} height={item.image.height} loading="lazy" alt="" /><h3><a href={item.url}>{item.title}</a></h3><a href={item.url}>Read article →</a></article>)}</div></section>}

    <div style={{ textAlign: 'center', marginTop: '3rem' }}>
      <a class="btn btn-primary" href="/blog/">Back to Blog</a>
    </div>
  </main>
</Layout>
