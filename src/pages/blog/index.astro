---
import Layout from '../../layouts/Layout.astro';
import cachedPosts from '../../../cache/wp_posts.json';
import { localPosts } from '../../data/localPosts';

let posts: any[] = [...localPosts, ...(cachedPosts as any[])];
try {
  const response = await fetch('https://cms.jtkonzult.com.ng/wp-json/wp/v2/posts?_embed&per_page=9', { signal: AbortSignal.timeout(8000) });
  if (response.ok) {
    const remotePosts = await response.json() as any[];
    posts = [...localPosts, ...remotePosts.filter((post: any) => !localPosts.some((local) => local.slug === post.slug))];
  }
} catch {
  // Use the checked-in CMS cache so a temporary CMS outage cannot remove the blog from a deployment.
}
---

<Layout title="Insights & Updates — J.T. Resources & Konzult Ltd" description="News, HR tips, success stories, and updates from J.T. Resources & Konzult Ltd.">
  <section style={{ background: 'var(--deep-teal)', color: '#fff', padding: '4rem 0' }}>
    <div class="container">
      <h1 style={{ color: '#fff', marginBottom: '0.5rem' }}>Insights & Updates</h1>
      <p style={{ color: 'rgba(255,255,255,0.85)', margin: 0 }}>News, HR tips, success stories, and updates from J.T. Resources & Konzult Ltd.</p>
    </div>
  </section>

  <main class="container section">
    <div style={{ background: '#f8fafc', borderLeft: '4px solid var(--primary-green)', padding: '1rem 1.25rem', marginBottom: '2rem' }}>
      <strong>Latest Insights:</strong> Explore our latest news, HR tips, and success stories from J.T. Resources & Konzult Ltd.
    </div>

    {posts.length === 0 ? (
      <div class="soft-card" style={{ padding: '2rem', textAlign: 'center', color: '#475569' }}>No posts available right now. Please try again later.</div>
    ) : (
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(260px, 1fr))', gap: '1.5rem' }}>
        {posts.map((post) => {
          const legacyHiringPost = post.slug === 'top-7-qualities-employers-look-for-when-hiring-in-nigeria-2025-guide';
          const rawTitle = post.title?.rendered ? post.title.rendered.replace(/<[^>]*>/g, '') : 'Untitled';
          const title = legacyHiringPost ? rawTitle.replace(' (2025 Guide)', ' (Updated Guide)') : rawTitle;
          const excerpt = legacyHiringPost ? 'Discover the communication, teamwork, digital and problem-solving qualities Nigerian employers value when evaluating candidates.' : (post.seoDescription || (post.excerpt?.rendered ? post.excerpt.rendered.replace(/<[^>]*>/g, '').slice(0, 160) : 'Read more about this update.'));
          const image = legacyHiringPost ? '/images/site/team-discussion.webp' : (post._embedded?.['wp:featuredmedia']?.[0]?.source_url || '/images/site/team-discussion.webp');
          const category = post._embedded?.['wp:term']?.[0]?.[0]?.name || '';
          const date = post.date ? new Date(post.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '';

          return (
            <article class="soft-card card-hover" style={{ overflow: 'hidden' }}>
              <img src={image} alt={title} width="740" height="416" loading="lazy" style={{ width: '100%', height: '220px', objectFit: 'cover' }} />
              <div style={{ padding: '1rem' }}>
                <div style={{ fontSize: '0.72rem', color: '#64748b' }}>{category ? `${category} • ${date}` : date}</div>
                <h3 style={{ marginTop: '0.7rem' }}>{title}</h3>
                <p style={{ color: '#475569', fontSize: '0.95rem', marginBottom: '1rem' }}>{excerpt}...</p>
                <a href={`/blog/${post.slug}`} style={{ color: 'var(--green-text)', fontWeight: 700 }}>Read More →</a>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </main>
</Layout>
