---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts, summarisePost, truncate } from '../../data/posts';

const posts = (await getAllPosts()).map(summarisePost);
---

<Layout title="Insights & Updates — J.T. Resources & Konzult Ltd" description="News, HR tips, success stories, and updates from J.T. Resources & Konzult Ltd.">
  <section style={{ background: 'var(--deep-teal)', color: '#fff', padding: '4rem 0' }}>
    <div class="container">
      <h1 style={{ color: '#fff', marginBottom: '0.5rem' }}>Insights & Updates</h1>
      <p style={{ color: 'rgba(255,255,255,0.85)', margin: 0 }}>News, HR tips, success stories, and updates from J.T. Resources & Konzult Ltd.</p>
    </div>
  </section>

  <main class="container section">
    <div style={{ background: '#f8fafc', borderLeft: '4px solid var(--primary-green)', padding: '1rem 1.25rem', marginBottom: '2rem' }}>
      <strong>Latest Insights:</strong> Explore our latest news, HR tips, and success stories from J.T. Resources & Konzult Ltd.
    </div>

    {posts.length === 0 ? (
      <div class="soft-card" style={{ padding: '2rem', textAlign: 'center', color: '#475569' }}>No posts available right now. Please try again later.</div>
    ) : (
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(260px, 1fr))', gap: '1.5rem' }}>
        {posts.map((post) => (
          <article class="soft-card card-hover" style={{ overflow: 'hidden' }}>
            <img src={post.image.url} alt={post.title} width={post.image.width} height={post.image.height} loading="lazy" style={{ width: '100%', height: '220px', objectFit: 'cover' }} />
            <div style={{ padding: '1rem' }}>
              <div style={{ fontSize: '0.72rem', color: '#64748b' }}>{post.category ? `${post.category} • ${post.displayDate}` : post.displayDate}</div>
              <h3 style={{ marginTop: '0.7rem' }}>{post.title}</h3>
              <p style={{ color: '#475569', fontSize: '0.95rem', marginBottom: '1rem' }}>{truncate(post.description)}</p>
              <a href={post.url} style={{ color: 'var(--green-text)', fontWeight: 700 }}>Read More →</a>
            </div>
          </article>
        ))}
      </div>
    )}
  </main>
</Layout>
